# Required for the live demo script (npm run demo). Unit tests and evals mock the model.
LLM_API_KEY=

# OpenAI-compatible chat completions base URL (no trailing slash required).
# Examples:
#   https://api.x.ai/v1
#   https://api.openai.com/v1
#   http://127.0.0.1:11434/v1
LLM_BASE_URL=https://api.x.ai/v1

# Model id for the configured endpoint.
LLM_MODEL=grok-4.6

# Optional request timeout in milliseconds (default 90000).
# LLM_TIMEOUT_MS=90000
